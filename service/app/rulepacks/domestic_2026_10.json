  "clauses": {
    "N3": {
      "id": "N3",
      "source_id": "national",
      "article": "제3조 및 별표 1",
      "summary": "여비 지급구분은 별표 1에 따른다. 이 계산기는 제2호 해당자만 지원한다."
    },
    "N5": {
      "id": "N5",
      "source_id": "national",
      "article": "제5조",
      "summary": "공무 여행에 실제로 필요한 일수로 계산한다. 사적 체류일을 자동으로 포함하지 않는다."
    },
    "N7": {
      "id": "N7",
      "source_id": "national",
      "article": "제7조",
      "summary": "출장 중 규정·계급 등의 변경으로 구분계산이 필요하면 사유 발생일을 기준으로 나눈다."
    },
    "N8": {
      "id": "N8",
      "source_id": "national",
      "article": "제8조의2제2항·제5항",
      "summary": "운임·숙박비는 세부 증거서류로 정산하며 교육훈련 여비는 별도 세부기준을 적용한다."
    },
    "N10": {
      "id": "N10",
      "source_id": "national",
      "article": "제10조제1항",
      "summary": "국내 철도운임은 별표 2에 따라 지급한다."
    },
    "N12": {
      "id": "N12",
      "source_id": "national",
      "article": "제12조",
      "summary": "항공운임은 공적 항공마일리지 등의 사용·감액 조건을 확인해야 한다."
    },
    "N13": {
      "id": "N13",
      "source_id": "national",
      "article": "제13조 및 별표 2 비고 제4호",
      "summary": "버스운임은 기준 요율의 실비이며 자가용은 대중교통 상당액 또는 별도 조건의 실비 기준을 확인한다."
    },
    "N15": {
      "id": "N15",
      "source_id": "national",
      "article": "제15조",
      "summary": "공용 차량·선박·항공기 이용 여행의 운임은 지급하지 않는다."
    },
    "N16_1": {
      "id": "N16_1",
      "source_id": "national",
      "article": "제16조제1항",
      "summary": "국내 일비·숙박비·식비는 별표 2를 적용한다. 부득이한 숙박비 초과 지출은 별도 요건으로 추가 지급 가능하다."
    },
    "N16_3": {
      "id": "N16_3",
      "source_id": "national",
      "article": "제16조제3항",
      "summary": "일비는 여행일수에 따라 지급하고 공무용 차량 이용 등에는 일비의 2분의 1을 지급한다."
    },
    "N16_4": {
      "id": "N16_4",
      "source_id": "national",
      "article": "제16조제4항",
      "summary": "숙박비는 실제 숙박하는 밤의 수를 기준으로 지급한다."
    },
    "N16_5": {
      "id": "N16_5",
      "source_id": "national",
      "article": "제16조제5항",
      "summary": "식비는 여행일수에 따라 지급한다. 수로·항공 여행은 별도 필요조건이 있다."
    },
    "N17": {
      "id": "N17",
      "source_id": "national",
      "article": "제17조",
      "summary": "동일 지역 장기체재는 도착 다음 날부터의 체재기간에 따라 일비 감액을 확인한다."
    },
    "N18": {
      "id": "N18",
      "source_id": "national",
      "article": "제18조제1항·제2항",
      "summary": "근무지 내 출장: 4시간 이상 20,000원, 미만 10,000원. 전용차량 배정자는 미지급, 공무용차량 등 이용은 10,000원 감액. 근무지내 분류 조건을 별도 확인한다."
    },
    "N28": {
      "id": "N28",
      "source_id": "national",
      "article": "제28조",
      "summary": "예산·외부 지원·지출 불필요 등 조정 사유와 상급자 동행에 따른 예외를 확인한다."
    },
    "N29_2": {
      "id": "N29_2",
      "source_id": "national",
      "article": "제29조의2",
      "summary": "지방자치단체에 근무하는 공무원은 해당 지방자치단체의 여비 조례를 적용한다."
    },
    "T2": {
      "id": "T2",
      "source_id": "national",
      "article": "별표 2 제2호 및 비고 제5호·제6호",
      "summary": "제2호: 철도 일반실 실비, 일비·식비 각 25,000원/일. 숙박 실비 상한은 서울 100,000원/박, 광역시 80,000원/박, 기타 70,000원/박. 통합특별시는 종전 지역 기준이며 할인 가능 시 할인요금 적용."
    },
    "G3": {
      "id": "G3",
      "source_id": "gyeonggi",
      "article": "제1조·제3조",
      "summary": "경기도 소속 공무원에 적용하며 계급별 국가 여비규정 별표 1을 적용한다. 경기도 내 시·군청 직원에게 자동 적용하지 않는다."
    },
    "G4": {
      "id": "G4",
      "source_id": "gyeonggi",
      "article": "제4조 본문·제1호·제5호·제8호",
      "summary": "조례의 예외를 제외하고 국가 여비규정의 예에 따른다. 카드 결제 조항 일부 제외와 소방공무원에 관한 준용 예외를 확인한다."
    },
    "G_NEAR": {
      "id": "G_NEAR",
      "source_id": "gyeonggi",
      "article": "제4조제4호의2",
      "summary": "근무지내 왕복 2km 이내 출장은 인사혁신처장이 정한 방식으로 실비 지급한다."
    },
    "M_LODGING": {
      "id": "M_LODGING",
      "source_id": "guide",
      "article": "제9장 Ⅳ.3.가.1) (본문 614쪽)",
      "summary": "여러 날 출장의 숙박비는 개별 밤마다 지출을 잘라 합산하지 않고 출장기간 전체 숙박비 총액한도 안에서 실비 정산한다.",
      "pdf_page": 615
    },
    "M_VEHICLE": {
      "id": "M_VEHICLE",
      "source_id": "guide",
      "article": "제9장 Ⅳ.5.나. (본문 617쪽)",
      "summary": "공무용 차량·그에 준하는 차량·임차차량을 사용한 여행일은 일비 2분의 1을 지급한다.",
      "pdf_page": 618
    },
    "M_NEAR": {
      "id": "M_NEAR",
      "source_id": "guide",
      "article": "제9장 Ⅲ.2.나.~마. (본문 602쪽)",
      "summary": "근무지내 1일 상한 20,000원. 왕복 2km 이내는 시간별 상한 안의 운임·조건부 식비 실비로 지급한다.",
      "pdf_page": 603
    },
    "M_TRAINING": {
      "id": "M_TRAINING",
      "source_id": "guide",
      "article": "제9장 Ⅱ.4.라. (본문 580쪽)",
      "summary": "교육훈련 여비는 공무원 인재개발 업무처리지침 등 별도 교육훈련 기준을 확인한다.",
      "pdf_page": 581
    }
  },
